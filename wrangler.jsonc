{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "old-rice-bbaa",
  "compatibility_date": "2026-07-18",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "ENQUIRY_EMAIL",
      "destination_address": "jaraad05@gmail.com"
    }
  ]
}
